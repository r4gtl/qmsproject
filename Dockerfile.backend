# Dockerfile.backend
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

WORKDIR /app

# Pre-installazione dipendenze di sistema
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    postgresql-client \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copia solo i file necessari per installare le dipendenze Python
COPY backend/requirements.txt .

# Upgrade pip e installazione requirements
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copia solo a questo punto tutto il codice
COPY backend/ /app/
COPY entrypoint.sh /entrypoint.sh
COPY wait_for_db.py /wait_for_db.py

RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
